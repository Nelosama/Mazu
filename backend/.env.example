# ─────────────────────────────────────────────────────────────
# Backend — variables de entorno (copiar a backend/.env)
# Nunca subas valores reales a Git.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# PostgreSQL. En Supabase:
#  - DATABASE_URL: conexión vía pooler (Supavisor, modo transacción, puerto 6543) con
#    ?pgbouncer=true&connection_limit=5
#  - DIRECT_DATABASE_URL: conexión directa (puerto 5432) usada por `prisma migrate`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking?schema=public

# Secreto de firma de tokens de acceso (≥ 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-aleatorio-de-48-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Orígenes permitidos por CORS (separados por comas) y URL pública del frontend
# usada para construir enlaces de gestión y encuestas.
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# true detrás de un proxy (Render, Vercel rewrites) para obtener la IP real del cliente.
TRUST_PROXY=false
# true para forzar cookies Secure (siempre activas con NODE_ENV=production).
COOKIE_SECURE=false

# Almacenamiento de imágenes: supabase | local (local solo en desarrollo/pruebas).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage
SUPABASE_URL=
# Clave service_role: SOLO en el backend. Jamás en el navegador ni en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=public-media
UPLOAD_MAX_BYTES=5242880

# Notificaciones
# Sin proveedor, en desarrollo los mensajes se registran en consola con estado DEV_LOGGED
# (no son envíos reales). En producción NOTIFICATIONS_DEV_LOG debe ser false.
NOTIFICATIONS_DEV_LOG=true
NOTIFICATIONS_WORKER_ENABLED=true
EMAIL_PROVIDER=none            # none | resend
RESEND_API_KEY=
EMAIL_FROM=                    # p. ej. "Reservas <reservas@tudominio.com>"
WHATSAPP_PROVIDER=none         # none | meta (WhatsApp Cloud API; tiene coste por conversación)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Planes y políticas
DEFAULT_PLAN_CODE=PRO          # plan asignado a negocios nuevos
TRIAL_DAYS=30                  # 0 = sin periodo de prueba (no hay cobro real activo)
DATA_RETENTION_MONTHS=24
FEEDBACK_TOKEN_TTL_DAYS=14
MAX_ACTIVE_BOOKINGS_PER_PHONE=3
JOBS_ENABLED=true
